rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      // Accept both old schema (author.id) and new schema (authorUid) for create
      allow create: if request.auth != null
        && (request.resource.data.author.id == request.auth.uid
            || request.resource.data.authorUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author.id == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Users / Profiles ───────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Users can write their own profile; founders/admins can write any profile
      // (required for role changes and suspension from Founder Control)
      allow write: if request.auth != null
        && (request.auth.uid == userId || isFounderOrAdmin());
    }

    // ── Followers / Following ──────────────────────────────
    // Structure: followers/{targetUid}/users/{followerUid}
    //            following/{currentUid}/users/{followedUid}
    // The document IDs are Firebase Auth UIDs — never usernames.
    match /followers/{targetUid}/users/{followerUid} {
      allow read: if true;
      // Only the follower themselves may create or delete their own follow record
      allow create: if request.auth != null && request.auth.uid == followerUid;
      allow delete: if request.auth != null && request.auth.uid == followerUid;
    }
    match /following/{currentUid}/users/{followedUid} {
      allow read: if true;
      // Only the person whose following list this is may write to it
      allow create: if request.auth != null && request.auth.uid == currentUid;
      allow delete: if request.auth != null && request.auth.uid == currentUid;
    }

    // ── Gallery ────────────────────────────────────────────
    match /gallery/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── User Preferences ───────────────────────────────────
    // Private — each user can only read and write their own preferences.
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Companion ──────────────────────────────────────────
    // Private — each user can only read and write their own companion data.
    match /companions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Stories ────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── Live Rooms ─────────────────────────────────────────
    // Created by the host when starting a live session (via live-room.html / live.js).
    // All users can read (for the live hub listing).
    // Only the room owner (hostId == auth.uid) may write metadata.
    // Live chat sub-collection is open to all authenticated users.
    match /liveRooms/{roomId} {
      allow read: if true;
      // Accept either hostId or ownerUid matching the authenticated user.
      // live.js writes both fields; this rule accepts either for resilience.
      allow create: if request.auth != null
        && (request.resource.data.hostId == request.auth.uid
            || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
            || isModeratorOrAbove());

      // Live chat messages
      match /liveMessages/{msgId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Site Settings (kill-switches, feature flags) ───────
    // Read by anyone; writable by founder/admin directly.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }

    // ── Founder Themes ─────────────────────────────────────
    // Managed directly from the browser by founder/admin (Firebase + Supabase architecture).
    // Active theme doc (id == 'active') is readable by all so themeService can load it.
    match /founderThemes/{themeId} {
      allow read: if themeId == 'active' || isFounderOrAdmin();
      allow write: if isFounderOrAdmin();
    }

    // ── Videos ────────────────────────────────────────────
    // Uploaded directly from the browser via Firebase Storage + Firestore.
    // Anyone can read public/unlisted videos; only the owner can write.
    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.owner.uid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.owner.uid == request.auth.uid
            || isModeratorOrAbove());

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author.id == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Cloud Stream Broadcasts ────────────────────────────
    // Creator can write their own; backend worker updates status fields.
    // Everyone can read (for listener discovery).
    match /cloudStreams/{streamId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── Now Playing (backend-managed, listeners read-only) ─
    match /studioCloudStreamMusic/{streamId} {
      allow read: if true;
      // Only the stream owner may write initial now-playing; backend overwrites it.
      allow write: if request.auth != null;
    }

    // ── 24-Hour Always-On Channel ──────────────────────────
    // channelNowPlaying: read by everyone (viewers need unauthenticated access).
    // Written by the frontend channel engine running as the founder/admin.
    // When no backend server is deployed, the founder's browser acts as the
    // schedule authority and writes the now-playing state directly.
    match /channelNowPlaying/{channelId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }
    // channel config + sub-collections:
    //   • Founders and admins may write programming and fallback directly
    //     from Channel Studio (no backend server needed in this architecture).
    //   • All other clients are read-only.
    match /channel/{channelId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
      match /programming/{itemId} {
        allow read: if true;
        allow create: if isFounderOrAdmin();
        allow update: if isFounderOrAdmin();
        allow delete: if isFounderOrAdmin();
      }
      match /fallback/{itemId} {
        allow read: if true;
        allow create: if isFounderOrAdmin();
        allow update: if isFounderOrAdmin();
        allow delete: if isFounderOrAdmin();
      }
    }

    // ── User Media Library ─────────────────────────────────
    // Each user owns their own media items (uploaded via Channel Studio).
    // Sub-path: userMedia/{uid}/items/{itemId}
    match /userMedia/{userId}/items/{itemId} {
      // Only the owning user may read or write their own media items.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Avenora Radio ──────────────────────────────────────
    // radioStations: written by the backend Admin SDK (which bypasses rules)
    //   OR directly by an authenticated admin/founder browser in the
    //   Firebase + Supabase production architecture (no backend server).
    match /radioStations/{stationId} {
      allow read: if true;
      // Backend Admin SDK bypasses rules; browser admin may write directly.
      allow write: if isFounderOrAdmin();
    }
    // stationNowPlaying: read by ALL radio listeners; written by backend or browser admin.
    match /stationNowPlaying/{stationId} {
      allow read: if true;
      // Backend Admin SDK bypasses rules; browser admin may write directly.
      allow write: if isFounderOrAdmin();
    }
    // Listener favourites — each user manages their own.
    match /radioFavorites/{uid}/tracks/{trackId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Creator Playlists ──────────────────────────────────
    // Owners manage their own playlists; no one else can read or write.
    match /studioPlaylists/{uid}/playlists/{plId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Music Hub Shared Playlists ─────────────────────────
    // Shared playlists readable by everyone (including unauthenticated for system playlists).
    // Private playlists readable only by their owner.
    // Create requires auth; update/delete by owner or moderator+.
    match /musicPlaylists/{playlistId} {
      allow read: if resource.data.visibility == 'shared'
                  || (request.auth != null && resource.data.createdByUid == request.auth.uid)
                  || resource.data.createdByUid == 'system';
      allow create: if request.auth != null
                    && (request.resource.data.createdByUid == request.auth.uid
                        || request.resource.data.createdByUid == 'system');
      allow update: if request.auth != null
                    && (resource.data.createdByUid == request.auth.uid
                        || resource.data.createdByUid == 'system'
                        || isModeratorOrAbove());
      allow delete: if request.auth != null
                    && (resource.data.createdByUid == request.auth.uid
                        || isModeratorOrAbove());

      match /tracks/{trackId} {
        allow read: if get(/databases/$(database)/documents/musicPlaylists/$(playlistId)).data.visibility == 'shared'
                    || get(/databases/$(database)/documents/musicPlaylists/$(playlistId)).data.createdByUid == 'system'
                    || (request.auth != null
                        && get(/databases/$(database)/documents/musicPlaylists/$(playlistId)).data.createdByUid == request.auth.uid);
        allow create: if request.auth != null
                      && request.resource.data.addedByUid == request.auth.uid;
        allow delete: if request.auth != null
                      && (resource.data.addedByUid == request.auth.uid
                          || isModeratorOrAbove());
      }
    }

    // ── Radio Queue (Firestore fallback when backend is down) ──
    // Anyone can read; authenticated users can add tracks to the queue;
    // only moderator+ can delete from the queue.
    match /radioQueue/{stationId}/tracks/{trackId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.addedByUid == request.auth.uid;
      allow delete: if request.auth != null && isModeratorOrAbove();
    }

    // ── Cloud Stream Track Library ─────────────────────────
    // Track metadata uploaded via Music Hub (musicUploadSubmit).
    // Write: only the owning user may create / delete their own tracks.
    // Read: any authenticated user may read — required so the Cloud Radio
    //       resolver (_resolvePlaylistTrackUrl) can look up tracks added to
    //       shared playlists regardless of which user uploaded them.
    //       Unauthenticated (anonymous) access is blocked.
    match /cloudStreamTracks/{uid}/tracks/{trackId} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read:  if request.auth != null;
    }

    // ── Helper functions ───────────────────────────────────
    function isModeratorOrAbove() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['moderator', 'admin', 'founder'];
    }
    function isFounderOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'founder'];
    }
  }
}
