rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author.id == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Users / Profiles ───────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      // Users can only write their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Gallery ────────────────────────────────────────────
    match /gallery/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
      allow update: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── User Preferences ───────────────────────────────────
    // Private — each user can only read and write their own preferences.
    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Companion ──────────────────────────────────────────
    // Private — each user can only read and write their own companion data.
    match /companions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Stories ────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.author.id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.author.id == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── Live Rooms ─────────────────────────────────────────
    // Created by the host when starting a live session (via live-room.html / live.js).
    // All users can read (for the live hub listing).
    // Only the room owner (hostId == auth.uid) may write metadata.
    // Live chat sub-collection is open to all authenticated users.
    match /liveRooms/{roomId} {
      allow read: if true;
      // Accept either hostId or ownerUid matching the authenticated user.
      // live.js writes both fields; this rule accepts either for resilience.
      allow create: if request.auth != null
        && (request.resource.data.hostId == request.auth.uid
            || request.resource.data.ownerUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.hostId == request.auth.uid
            || resource.data.ownerUid == request.auth.uid
            || isModeratorOrAbove());

      // Live chat messages
      match /liveMessages/{msgId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Site Settings (kill-switches, feature flags) ───────
    // Read by anyone; only writable by founder/admin via the backend.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if false; // managed exclusively by the backend / Founder Control Center
    }

    // ── Founder Themes ─────────────────────────────────────
    // No ordinary user or moderator may read, write, or list founder themes.
    // Theme tokens are served from the backend API (/api/themes/active)
    // which applies its own validation — no direct Firestore access needed.
    match /founderThemes/{themeId} {
      allow read, write: if false; // managed exclusively by the backend
    }

    // ── Videos ────────────────────────────────────────────
    // Uploaded directly from the browser via Firebase Storage + Firestore.
    // Anyone can read public/unlisted videos; only the owner can write.
    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.owner.uid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.owner.uid == request.auth.uid
            || isModeratorOrAbove());

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author.id == request.auth.uid
              || isModeratorOrAbove());
      }
    }

    // ── Cloud Stream Broadcasts ────────────────────────────
    // Creator can write their own; backend worker updates status fields.
    // Everyone can read (for listener discovery).
    match /cloudStreams/{streamId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || isModeratorOrAbove());
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || isModeratorOrAbove());
    }

    // ── Now Playing (backend-managed, listeners read-only) ─
    match /studioCloudStreamMusic/{streamId} {
      allow read: if true;
      // Only the stream owner may write initial now-playing; backend overwrites it.
      allow write: if request.auth != null;
    }

    // ── Creator Playlists ──────────────────────────────────
    // Owners manage their own playlists; no one else can read or write.
    match /studioPlaylists/{uid}/playlists/{plId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Cloud Stream Track Library ─────────────────────────
    // Track metadata uploaded via Music Hub (musicUploadSubmit).
    // Write: only the owning user may create / delete their own tracks.
    // Read: owner always; any authenticated user may read public tracks
    //       so the cloud stream player can resolve download URLs.
    match /cloudStreamTracks/{uid}/tracks/{trackId} {
      allow write: if request.auth != null && request.auth.uid == uid;
      // Owner reads their own library unconditionally.
      // Other authenticated users can read tracks whose visibility != 'private'
      // so the 24-hour cloud stream player can serve them.
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || resource == null
            || resource.data.visibility != 'private');
    }

    // ── Helper functions ───────────────────────────────────
    function isModeratorOrAbove() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ['moderator', 'admin', 'founder'];
    }
  }
}
