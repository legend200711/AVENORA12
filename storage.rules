rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatars ────────────────────────────────────────────
    // Users can only write their own avatar; everyone can read
    match /avatars/{userId}.{ext} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // ── Avatars — subdirectory form avatars/{uid}/filename ──
    // Catches uploadAvatar() paths that include a subdirectory.
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // ── Images (posts, gallery, stories) ──────────────────
    // Flat path images/{filename} — used by uploadImage() / gallery / feed
    match /images/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    // ── Thumbnails — nested under images/ ─────────────────
    // Path: images/thumbnails/{uid}/{filename}
    // Used by video upload thumbnail phase.
    match /images/thumbnails/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // ── Audio (music uploads) ──────────────────────────────
    // Top-level audio/{filename} — legacy / StorageService.uploadAudio()
    match /audio/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('audio/.*|application/octet-stream')
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // Per-user audio path: audio/{uid}/{filename}
    // Used by Music Hub cloud upload (musicUploadSubmit).
    match /audio/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024; // 100 MB
    }

    // ── Videos (flat top-level path) ───────────────────────
    match /videos/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024 * 1024; // 2 GB
    }

    // ── Videos per-user path: videos/{uid}/{filename} ──────
    // Used by the Video page Firebase Storage direct upload (initUploadForm).
    match /videos/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 * 1024; // 2 GB
    }
  }
}
