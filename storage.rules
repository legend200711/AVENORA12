/**
 * AVENORA — Firebase Storage Rules
 *
 * NOTE: Firebase Storage is no longer used for file uploads in this project.
 * All file uploads (avatars, gallery, music, video, thumbnails, stream-media)
 * are routed through the AVENORA backend and stored in Supabase Storage.
 *
 * These rules are kept as a safety measure to deny all access to the
 * Firebase Storage bucket in case any legacy code still references it.
 *
 * To re-enable specific paths, replace the deny-all rule below with
 * the appropriate read/write rules.
 *
 * Storage provider: Supabase Storage
 *   Buckets: avatars, gallery, music, videos, thumbnails, stream-media
 *   Setup: see SUPABASE_SETUP.md
 */

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all reads and writes — storage has been migrated to Supabase.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
