# ============================================================
# AVENORA — Backend Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# ─── CORS — Allowed Frontend Origins ─────────────────────────────────────────
# FRONTEND_URL  — primary frontend origin (GitHub Pages, custom domain, etc.)
# FRONTEND_URL_2 — optional additional origin (e.g. a staging URL)
#
# GitHub Pages example:
#   FRONTEND_URL=https://legend200711.github.io
#
# Custom domain example:
#   FRONTEND_URL=https://app.avenora.app
#
# Note: http://localhost:3000 and http://localhost:5173 are always allowed for
# local development regardless of this setting.
# All github.io subdomains are also allowed automatically.
#
FRONTEND_URL=https://legend200711.github.io
FRONTEND_URL_2=

# ─── Frontend API URL ─────────────────────────────────────────────────────
# The URL that the frontend uses to reach this backend.
# This is set in the frontend as window.LU_CONFIG.apiUrl (in index.html)
# or as VITE_API_BASE_URL in the frontend .env file (if using Vite).
#
# For local development: http://localhost:3001
# For production:        https://your-deployed-backend.com
#
# Example (add to frontend/index.html or frontend/.env):
#   window.LU_CONFIG = { apiUrl: "https://your-backend.com/api" }
# OR
#   VITE_API_BASE_URL=https://your-backend.com
#
# Active Firebase project: avenora-6e147
# ─────────────────────────────────────────────────────────────────────────

# ─── Firebase Configuration ──────────────────────────────────────────────────
# Active Firebase project: avenora-6e147
# These values are used by the backend auth middleware to verify Firebase ID tokens.
#
# FIREBASE_PROJECT_ID — Firebase project ID
# FIREBASE_WEB_API_KEY — Firebase Web API key (used ONLY for server-side token verification
#                        via the Google Identity Toolkit REST API — NOT a service account key)
#
FIREBASE_PROJECT_ID=avenora-6e147
FIREBASE_WEB_API_KEY=AIzaSyDnEEYamIVYfn7l6sPPS1Dp2fWJE34OXlI

# ─── Firestore (primary database) ────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON — Full JSON string of the Firebase service-account key.
# Get it from: Firebase Console → Project Settings → Service Accounts
#              → Generate new private key → copy the entire file content here.
#
# On Render, set this as a secret environment variable (never commit real values).
#
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"avenora-6e147",...}
#
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to point to a key file path.
#

# JWT Authentication
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_64_CHARS

# Founder Control Center — authorized email address
# Set this to the exact email of the authorized platform founder.
#
# Security contract:
#   1. Every request to /api/admin/* and /api/admin/themes/* checks that the
#      caller's JWT email matches this value server-side (in addition to role).
#   2. Accounts registered with this email are automatically assigned role=founder.
#   3. This value is NEVER sent to the client or logged in responses.
#   4. Run `node scripts/promote-founder.js` once after setting this value to
#      promote an existing account if it was created before this variable was set.
#
FOUNDER_EMAIL=christijerina46@gmail.com
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# AVENORA uses Supabase Storage for all media uploads.
# All audio, video, image, avatar, gallery, and stream-media files are stored
# in Supabase Storage buckets managed by the backend.
#
# Required:
#   SUPABASE_URL              — Your project URL, e.g. https://xxxxx.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY — Service-role key (NEVER expose in frontend code)
#   SUPABASE_ANON_KEY         — Anon/public key (safe for read-only frontend use)
#
# Buckets created automatically on first startup:
#   avatars      — user profile pictures (private, signed URLs)
#   gallery      — gallery images (public)
#   music        — uploaded audio files (private, signed URLs)
#   videos       — uploaded video files (private, signed URLs)
#   thumbnails   — video/playlist artwork (public)
#   stream-media — 24-hour cloud stream media library (private, signed URLs)
#
# See SUPABASE_SETUP.md for bucket policy setup instructions.
#
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Max upload sizes
MAX_FILE_SIZE_MB=500
MUSIC_MAX_FILE_MB=100

# ─── AVENORA Live — MediaMTX (browser-based WHIP/HLS streaming) ──────────────
# AVENORA Live uses WebRTC/WHIP from the browser to MediaMTX, then HLS for viewers.
# No OBS, Streamlabs, or RTMP encoder required.
#
# MediaMTX must be deployed separately (self-hosted, open-source).
# See docs/mediamtx.yml for a complete reference configuration.
#
# MEDIAMTX_BASE_URL   — Base URL of your MediaMTX instance (e.g. https://media.example.com)
# MEDIAMTX_WHIP_URL   — WHIP endpoint base for publishers (browser → MediaMTX)
#                       e.g. https://media.example.com/whip
#                       Full URL: <MEDIAMTX_WHIP_URL>/<stream-path>/whip
# MEDIAMTX_HLS_URL    — HLS delivery base URL for viewers
#                       e.g. https://media.example.com/hls
#                       Full URL: <MEDIAMTX_HLS_URL>/<stream-path>/index.m3u8
# MEDIAMTX_API_URL    — MediaMTX management API (used for health checks and publisher status)
#                       e.g. http://localhost:9997  (internal/private — NOT exposed to frontend)
# LIVE_PUBLIC_BASE_URL — Public base URL for the AVENORA live feature (used in og tags etc.)
#                        e.g. https://app.legenduniverse.com
# LIVE_SESSION_TIMEOUT_SECONDS — Seconds of heartbeat silence before a live session is
#                                considered stale (default 3600 = 1 hour)
#
# Leave all blank — deployment is required before live streaming will work.
MEDIAMTX_BASE_URL=
MEDIAMTX_WHIP_URL=
MEDIAMTX_HLS_URL=
MEDIAMTX_API_URL=
LIVE_PUBLIC_BASE_URL=
LIVE_SESSION_TIMEOUT_SECONDS=3600

# Search (MeiliSearch)
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=

# Email (Resend)
# RESEND_API_KEY=

# Web Push (VAPID)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@legenduniverse.com

# ─── 24-Hour Cloud Stream ─────────────────────────────────
# Directory on the server containing media files for the stream.
# Absolute or relative to the backend process working directory.
CLOUD_STREAM_MEDIA_DIR=./media

# Comma-separated RTMP ingest URL(s). Leave blank to run in simulation mode.
# Examples: rtmp://a.rtmp.youtube.com/live2/YOUR_KEY,rtmp://live.twitch.tv/app/YOUR_KEY
CLOUD_STREAM_RTMP_TARGETS=

# Shuffle the playlist on start (default: true). Set to "false" to play in order.
CLOUD_STREAM_SHUFFLE=true

# Loop back to start when queue ends (default: true). Set to "false" to stop.
CLOUD_STREAM_REPEAT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
